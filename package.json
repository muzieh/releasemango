{
  "name": "releasemango",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "files": [
    "dist/cli",
    "dist/domain",
    "dist/evaluator",
    "dist/generator",
    "dist/git",
    "dist/hints",
    "dist/inspection",
    "dist/reporting",
    "scenarios/tutorial-01.yml",
    "fixtures/tiny-node-api/baseline",
    "fixtures/tiny-node-api/changes",
    "fixtures/tiny-node-api/states.json",
    "fixtures/tiny-node-api/judging/check.mjs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.18.0",
  "bin": {
    "releasemango": "./dist/cli/index.js"
  },
  "exports": {
    ".": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dashboard": "pnpm build && node dist/workflow-status/main.js",
    "lint": "eslint .",
    "pretest": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "execa": "^9.6.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/node": "^22.18.10",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.4"
  }
}
